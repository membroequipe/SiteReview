---
layout: null
---
[
  {%- assign searchable_items = "" | split: "" -%}
  {%- for post in site.posts -%}
    {%- assign searchable_items = searchable_items | push: post -%}
  {%- endfor -%}
  {%- for page in site.pages -%}
    {%- if page.title and page.url != '/404.html' and page.url != '/search.json' -%}
      {%- assign searchable_items = searchable_items | push: page -%}
    {%- endif -%}
  {%- endfor -%}

  {%- for item in searchable_items -%}
    {
      "title"    : {{ item.title | jsonify }},
      "category" : {{ item.category | default: item.categories | join: ', ' | jsonify }},
      "tags"     : {{ item.tags | join: ', ' | jsonify }},
      "url"      : {{ item.url | relative_url | jsonify }},
      "excerpt"  : {{ item.description | default: item.excerpt | strip_html | normalize_whitespace | truncatewords: 22 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
